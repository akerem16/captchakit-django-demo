# Copy to .env for local runs. Never commit real secrets.

# Required when DJANGO_DEBUG is false. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Full origins incl. scheme, e.g. https://example.onrender.com
CSRF_TRUSTED_ORIGINS=

# Optional: defaults to SQLite in the project folder.
DATABASE_URL=

# Optional: without it captchas live in process memory (single worker only).
REDIS_URL=redis://localhost:6379/0

CAPTCHA_TTL=180
CAPTCHA_MAX_ATTEMPTS=3
