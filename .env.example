# Copy to .env for local runs. Never commit real secrets.

# Required when DJANGO_DEBUG is false. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Full origins incl. scheme, e.g. https://example.com (Render's own host is added automatically)
CSRF_TRUSTED_ORIGINS=

# Production only (DJANGO_DEBUG=false):
# DJANGO_SECURE_SSL_REDIRECT=true
# DJANGO_HSTS_SECONDS=31536000

# Optional: defaults to SQLite in the project folder.
DATABASE_URL=

# Optional: without it captchas live in process memory (single worker only).
REDIS_URL=redis://localhost:6379/0

CAPTCHA_TTL=180
CAPTCHA_MAX_ATTEMPTS=3
# POST /api/captcha/ per client IP: burst size and tokens per second.
CAPTCHA_RATE_CAPACITY=5
CAPTCHA_RATE_REFILL=0.2
# Reverse proxies in front of the app (Render: 3 = Cloudflare + Render). 0 = use REMOTE_ADDR.
TRUSTED_PROXY_COUNT=0
